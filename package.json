{
  "name": "procurva-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:mirrors": "node scripts/check-tier-selector-mirror.mjs && node scripts/check-color-helper-mirror.mjs",
    "check:opacity": "node scripts/check-dead-opacity.mjs",
    "check:radius": "node scripts/check-hardcoded-radius.mjs",
    "check": "npm run check:mirrors && npm run check:opacity && npm run check:radius",
    "prebuild": "npm run check",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run check && tsc --noEmit",
    "lint": "npm run check && tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.456.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
